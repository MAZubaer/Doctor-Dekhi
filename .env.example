# Copy this file to .env and fill in real values. Never commit .env.

# Neon connection string. The scheme must be postgresql+psycopg:// (Neon's
# dashboard gives postgresql://, so change the start of the URL).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: connection string for a Neon dev branch, with the same scheme.
# DEV_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DEV_HOST/DBNAME?sslmode=require

# dev uses DEV_DATABASE_URL and fails at startup if that is not set.
# prod (the default) uses DATABASE_URL.
# APP_ENV=dev

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
